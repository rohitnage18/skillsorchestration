{
  "name": "skills-mcp-server",
  "version": "1.0.0",
  "description": "MCP server exposing a local library of domain-specific SKILL.md files to Claude Code, Cursor, and other MCP-compatible tools.",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "skills-mcp-server": "build/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/make-executable.mjs",
    "watch": "tsc --watch",
    "test": "npm run build && node --test build/*.test.js",
    "start": "node build/index.js"
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "fast-uri": "3.1.4"
  }
}
